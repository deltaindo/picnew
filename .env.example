# DATABASE CONFIGURATION
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=pic_app
DB_PORT=5432

# BACKEND CONFIGURATION
NODE_ENV=production
PORT=5000
JWT_SECRET=your_very_secure_jwt_secret_generate_random_string_here
JWT_EXPIRY=24h

# FRONTEND CONFIGURATION
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# CLOUDFLARE TUNNEL CONFIGURATION
# Get this from Cloudflare Dashboard: Networks > Tunnels > Your Tunnel > Copy Token
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiYWJjMTIzIiwgInQiOiAidG9rZW4iLCAic3MiOiAic2VjcmV0In0=

# CLOUDFLARE DOMAIN
# Replace with your actual domain
CLOUDFLARE_DOMAIN=yourdomain.com

# OPTIONAL: ADDITIONAL CONFIGURATION
# Uncomment and modify as needed

# LOG_LEVEL=info
# SESSION_SECRET=your_session_secret_here
# REDIS_URL=redis://redis:6379
